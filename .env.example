# 建置用（正式站在 GitHub repository variables 設定，見 CLAUDE.md「部署」）
PUBLIC_SITE_STAGE=        # production 才會開放收錄、載入 GA
PUBLIC_SITE_URL=          # 預設 https://3jwellness.com，一般不用設
PUBLIC_BASE_PATH=         # 子路徑，GitHub Pages 專案站用 /sanjie-yikang11；正式網域留空
PUBLIC_GA_ID=             # GA4 評估 ID，G- 開頭
PUBLIC_GSC_TOKEN=         # Search Console 的 google-site-verification content 值（用網域資源驗證可留空）

# pnpm seo 用（GSC / GA4 查詢）
GSC_SITE=                 # 預設 sc-domain:3jwellness.com
GA_PROPERTY=              # 預設 565563726（GA4 資源 ID，純數字，不是 G- 開頭）
GOOGLE_SA_EMAIL=          # 服務帳號 email（本機以 gcloud 模擬，不下載金鑰）
GOOGLE_SA_KEY_JSON=       # 雲端 session 用：服務帳號 JSON 金鑰全文（只放在雲端環境設定，不進版控）
