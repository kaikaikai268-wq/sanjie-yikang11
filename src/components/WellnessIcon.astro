---
// Official Lucide SVG geometry, adapted into a dependency-free Astro component.
// Source: https://github.com/lucide-icons/lucide/tree/main/icons
// ISC license, with MIT notices for Feather-derived icons: public/licenses/lucide.txt.
type IconName = 'leaf' | 'book' | 'sun' | 'moon' | 'arrow' | 'search' | 'shield';
interface Props {
  name: IconName;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}
const { name, size = 'md', class: className } = Astro.props;
const icons: Record<IconName, { paths: string[]; circle?: { cx: number; cy: number; r: number } }> = {
  leaf: { paths: [
    'M11 20a10 10 0 0010-10 25.9 25.9 0 00-1.04-7.281 1 1 0 00-1.755-.325C15.833 5.5 13 5.5 9.8 6.1A7 7 0 0011 20',
    'M2 21a5 5 0 012.911-4.544C7.613 15.212 8.351 15.24 11 13',
  ] },
  book: { paths: [
    'M12 5v16',
    'M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z',
  ] },
  sun: { circle: { cx: 12, cy: 12, r: 4 }, paths: [
    'M12 2v2', 'M12 20v2', 'm4.93 4.93 1.41 1.41', 'm17.66 17.66 1.41 1.41',
    'M2 12h2', 'M20 12h2', 'm6.34 17.66-1.41 1.41', 'm19.07 4.93-1.41 1.41',
  ] },
  moon: { paths: ['M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401'] },
  arrow: { paths: ['M5 12h14', 'm12 5 7 7-7 7'] },
  search: { circle: { cx: 11, cy: 11, r: 8 }, paths: ['m21 21-4.34-4.34'] },
  shield: { paths: [
    'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z',
    'm9 12 2 2 4-4',
  ] },
};
const icon = icons[name];
---
<svg class:list={['wellness-icon', `wellness-icon--${size}`, className]} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {icon.circle && <circle cx={icon.circle.cx} cy={icon.circle.cy} r={icon.circle.r} />}
  {icon.paths.map((d) => <path d={d} />)}
</svg>
<style>
  .wellness-icon { display: inline-block; flex: none; vertical-align: middle; }
  .wellness-icon--sm { width: 1.125rem; height: 1.125rem; }
  .wellness-icon--md { width: 1.5rem; height: 1.5rem; }
  .wellness-icon--lg { width: 2rem; height: 2rem; }
</style>
