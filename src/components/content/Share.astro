---
interface Props { url: string; title: string }
const { url, title } = Astro.props;
const lineUrl = `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(url)}`;
---
<div class="content-share" data-share>
  <span>分享這篇文章</span>
  <a class="btn btn-outline" href={lineUrl} target="_blank" rel="noopener noreferrer" aria-label={`將「${title}」分享到 LINE`}>分享到 LINE</a>
  <button class="btn btn-outline" type="button" data-copy-url={url}>複製網址</button>
  <span class="content-share-status" role="status" aria-live="polite" aria-atomic="true"></span>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-share]').forEach((root) => {
    root.querySelector<HTMLButtonElement>('[data-copy-url]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const status = root.querySelector<HTMLElement>('[role="status"]');
      if (!status) return;
      button.disabled = true;
      status.textContent = '正在複製網址';
      try { await navigator.clipboard.writeText(button.dataset.copyUrl || location.href); status.textContent = '網址已複製'; }
      catch { status.textContent = '請從瀏覽器網址列複製文章網址'; }
      finally { button.disabled = false; }
    });
  });
</script>
