---
import Icon from '../Icon.astro';
---
<template data-image-viewer-control><button type="button" class="image-enlarge"><Icon name="external" />放大圖片</button></template>
<dialog class="image-viewer" aria-labelledby="image-viewer-title" data-image-viewer>
  <div class="image-viewer-header"><h2 id="image-viewer-title">圖片</h2><form method="dialog"><button type="submit" autofocus>關閉</button></form></div>
  <figure><img alt="" decoding="async" /><figcaption></figcaption></figure>
</dialog>
<script>
  const viewer = document.querySelector<HTMLDialogElement>('[data-image-viewer]');
  const template = document.querySelector<HTMLTemplateElement>('[data-image-viewer-control]');
  if (viewer && template && typeof viewer.showModal === 'function') {
    const enlarged = viewer.querySelector<HTMLImageElement>('img')!;
    const caption = viewer.querySelector<HTMLElement>('figcaption')!;
    document.querySelectorAll<HTMLElement>('figure.article-cover, figure.topic-cover, figure.directory-topic-visual').forEach((figure) => {
      const image = figure.querySelector<HTMLImageElement>('img');
      if (!image) return;
      const fragment = template.content.cloneNode(true) as DocumentFragment;
      const control = fragment.querySelector<HTMLButtonElement>('button')!;
      control.setAttribute('aria-label', `放大圖片：${image.alt || '內容配圖'}`);
      control.addEventListener('click', () => {
        enlarged.src = image.src;
        enlarged.alt = image.alt;
        caption.textContent = figure.querySelector('figcaption')?.textContent ?? '';
        viewer.showModal();
      });
      figure.append(fragment);
    });
    viewer.addEventListener('click', (event) => {
      if (event.target !== viewer) return;
      const box = viewer.getBoundingClientRect();
      if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) viewer.close();
    });
    viewer.addEventListener('close', () => { enlarged.removeAttribute('src'); });
  }
</script>
<style is:global>
  .image-enlarge { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; margin-top: 0.5rem; padding: 0.3rem 0; font: inherit; font-size: var(--text-xs); color: var(--navy); border: 0; background: transparent; cursor: pointer; text-decoration: underline; text-underline-offset: 0.2em; }
  .image-viewer { max-width: min(75rem, calc(100vw - 2rem)); width: 100%; max-height: calc(100dvh - 2rem); padding: 1rem 1.25rem; border: 1px solid var(--line); background: var(--bg-page); color: var(--text-primary); overscroll-behavior: contain; }
  .image-viewer::backdrop { background: oklch(0.18 0.02 245 / 0.85); }
  .image-viewer-header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1rem; }
  .image-viewer-header h2 { font-size: var(--text-sm); margin: 0; }
  .image-viewer-header button { font: inherit; font-size: var(--text-xs); min-height: 2.75rem; padding: 0.3rem 0.9rem; background: var(--bg-page); color: var(--navy); border: 1px solid var(--line); cursor: pointer; }
  .image-viewer figure { margin: 0; }
  .image-viewer img { max-height: 72dvh; width: 100%; object-fit: contain; }
  .image-viewer figcaption { margin-top: 0.75rem; color: var(--text-secondary); font-size: var(--text-xs); }
</style>
