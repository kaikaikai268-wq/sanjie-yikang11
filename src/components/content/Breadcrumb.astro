---
import { u } from '../../lib/url';
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---
<nav class="content-breadcrumb" aria-label="麵包屑">
  <ol>{items.map((item) => <li>{item.href ? <a href={u(item.href)}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>)}</ol>
</nav>
