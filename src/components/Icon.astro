---
// Local, pinned Lucide SVGs. Decorative by default; the surrounding control supplies its label.
import search from '../assets/icons/search.svg?raw';
import arrow from '../assets/icons/arrow-right.svg?raw';
import external from '../assets/icons/arrow-up-right.svg?raw';
import book from '../assets/icons/book-open.svg?raw';
import food from '../assets/icons/utensils.svg?raw';
import label from '../assets/icons/scan-line.svg?raw';
import moon from '../assets/icons/moon.svg?raw';
import share from '../assets/icons/share-2.svg?raw';
import copy from '../assets/icons/copy.svg?raw';
const icons = { search, arrow, external, book, food, label, moon, share, copy };
export type IconName = keyof typeof icons;
interface Props { name: IconName; }
const { name } = Astro.props;
---
<span class="site-icon" aria-hidden="true" set:html={icons[name]} />
<style>
  .site-icon { display: inline-flex; flex: none; width: 1.35rem; height: 1.35rem; vertical-align: middle; }
  .site-icon :global(svg) { display: block; width: 100%; height: 100%; stroke-width: 1.65; }
</style>
