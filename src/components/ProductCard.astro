---
import { u } from '../lib/url';
import { Image } from 'astro:assets';
import { BRANDS, type Product } from '../data/products';
import { productImage } from '../lib/images';
interface Props { product: Product; headingLevel?: 'h2' | 'h3' }
const { product: p, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<article class="product-card" data-category={p.category} data-name={`${p.name} ${BRANDS[p.brand].name}`}>
  <a class="product-image" href={u(`/products/${p.id}/`)} tabindex="-1" aria-hidden="true">
    <Image src={productImage(p.id)} alt="" widths={[320, 480, 640]} sizes="(max-width: 640px) 100vw, 360px" loading="lazy" />
  </a>
  <div class="product-body">
    <p class="audience"><span>適合誰？</span>{p.audience}</p>
    <span class="tag">{BRANDS[p.brand].name}</span>
    <H class="product-name"><a href={u(`/products/${p.id}/`)}>{p.name}</a></H>
    <ul class="points">{p.points.map((t) => <li>{t}</li>)}</ul>
  </div>
</article>
