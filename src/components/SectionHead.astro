---
interface Props { eyebrow?: string; title: string; lead?: string; level?: 'h1' | 'h2'; center?: boolean }
const { eyebrow, title, lead, level = 'h2', center = false } = Astro.props;
const H = level;
---
<div class:list={['section-head', { center }]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <H class="section-title">{title}</H>
  {lead && <p class="lead">{lead}</p>}
</div>
