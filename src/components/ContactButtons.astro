---
import { CONTACT } from '../data/site';
---
<div class="contact-buttons">
  <a class="btn btn-primary" href={CONTACT.facebook.href} target="_blank" rel="noopener noreferrer" data-ga-contact={CONTACT.facebook.ga}>{CONTACT.facebook.label}</a>
  <a class="btn btn-outline" href={CONTACT.instagram.href} target="_blank" rel="noopener noreferrer" data-ga-contact={CONTACT.instagram.ga}>{CONTACT.instagram.label}</a>
  <a class="btn btn-outline" href={CONTACT.phone.href} data-ga-contact={CONTACT.phone.ga}>電話 {CONTACT.phone.label}</a>
</div>
