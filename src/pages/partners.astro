---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { PARTNER_BRANDS } from '../data/site';
import { BRANDS } from '../data/products';
import { siteImage } from '../lib/images';
import { u } from '../lib/url';
---
<Base title="品牌合作" description="三傑益康的合作品牌、商品資訊及內容合作聯絡入口。">
  <section class="section">
    <div class="wrap">
      <SectionHead level="h1" eyebrow="BRAND PARTNERSHIPS" title="品牌合作" lead="認識合作品牌與商品資訊，進一步了解合作方式。" />
      <div class="partner-list">
        {PARTNER_BRANDS.map((b) => (
          <article class="partner">
            <div class="partner-logo">
              {b.image
                ? <Image src={siteImage(b.image)} alt={b.imageAlt} widths={[260, 520]} sizes="260px" />
                : <p class="wordmark">LODES<small>樂地滋營養食品</small></p>}
            </div>
            <div>
              <span class="tag">{b.tag}</span>
              <h2 class="subhead">{b.title}</h2>
              <p>{b.desc}</p>
              <ul class="chips">{b.tags.map((t) => <li>{t}</li>)}</ul>
              <p><a href={BRANDS[b.key].officialUrl} target="_blank" rel="noopener noreferrer">{BRANDS[b.key].officialLabel} ↗</a></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-sage"><div class="wrap"><SectionHead title="內容與品牌合作" lead="希望討論主題、品牌或通路合作，歡迎先說明你的需求。" /><div class="contact-buttons"><a class="btn btn-primary" href={u('/contact/')}>聯絡合作</a><a class="btn btn-outline" href={u('/resources/')}>場地與活動資源</a></div></div></section>
</Base>
