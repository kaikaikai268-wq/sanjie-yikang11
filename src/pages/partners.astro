---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { PARTNER_BRANDS, VENUE } from '../data/site';
import { BRANDS } from '../data/products';
import { siteImage } from '../lib/images';
---
<Base title="合作夥伴" description={VENUE.intro}>
  <section class="section">
    <div class="wrap">
      <SectionHead level="h1" eyebrow="商品 × 場地 × 活動資源" title="合作夥伴" lead={VENUE.intro} />
      <div class="partner-list">
        {PARTNER_BRANDS.map((b) => (
          <article class="partner">
            <div class="partner-logo">
              {b.image
                ? <Image src={siteImage(b.image)} alt={b.imageAlt} widths={[260, 520]} sizes="260px" />
                : <p class="wordmark">LODES<small>樂地滋營養食品</small></p>}
            </div>
            <div>
              <span class="tag">{b.tag}</span>
              <h2 class="subhead">{b.title}</h2>
              <p>{b.desc}</p>
              <ul class="chips">{b.tags.map((t) => <li>{t}</li>)}</ul>
              <p><a href={BRANDS[b.key].officialUrl} target="_blank" rel="noopener noreferrer">{BRANDS[b.key].officialLabel} ↗</a></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-sage">
    <div class="wrap">
      <SectionHead eyebrow="知域國際" title="場地與活動資源" />
      <div class="card-grid two">
        {VENUE.offers.map((o) => (
          <article class="card venue">
            <Image src={siteImage(o.image)} alt={o.imageAlt} widths={[480, 720]} sizes="(max-width: 900px) 100vw, 540px" />
            <span class="tag">{o.badge}</span>
            <h3>{o.title}</h3>
            <p>{o.desc}</p>
            <ul class="chips">{o.tags.map((t) => <li>{t}</li>)}</ul>
            <a class="btn btn-primary" href={o.cta.href} target="_blank" rel="noopener noreferrer" data-ga-contact={o.cta.ga}>{o.cta.label}</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
