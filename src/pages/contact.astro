---
import Base from '../layouts/Base.astro';
import { CONTACT } from '../data/site';
import { u } from '../lib/url';
---
<Base title="聯絡資訊" description="三傑益康正式聯絡管道的公開資訊。" noindex={CONTACT.length === 0}>
  <section class="section"><div class="wrap contact-page"><h1>聯絡資訊</h1>
    {CONTACT.length ? <ul>{CONTACT.map((channel) => <li><a href={channel.href} data-ga-contact={channel.ga}>{channel.label}</a></li>)}</ul> : <><p>正式聯絡管道將於確認後公布。</p><p>目前可以先閱讀健康文章與主題指南。</p></>}
    <nav aria-label="繼續閱讀"><a href={u('/articles/')}>健康文章</a><a href={u('/topics/')}>主題指南</a></nav>
  </div></section>
</Base>
<style>.contact-page { max-width: 49rem; min-height: 45vh; }.contact-page nav { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 2rem; font-size: var(--text-sm); }</style>
