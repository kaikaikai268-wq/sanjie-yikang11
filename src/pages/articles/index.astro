---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/content/Breadcrumb.astro';
import ArticleList from '../../components/content/ArticleList.astro';
import { getPublishedArticles, articleSlug } from '../../lib/content';
import { ARTICLE_PAGE_SIZE, listSchema, breadcrumbSchema } from '../../lib/content-view';
import '../../styles/content.css';
const all = await getPublishedArticles();
const articles = all.slice(0, ARTICLE_PAGE_SIZE);
const categories = [...new Set(all.map((article) => article.data.category))];
const totalPages = Math.max(1, Math.ceil(all.length / ARTICLE_PAGE_SIZE));
const schema = [listSchema('健康文章', '/articles/', articles.map((article) => ({ title: article.data.title, path: `/articles/${articleSlug(article)}/` })), Astro.site), breadcrumbSchema([{ label: '首頁', path: '/' }, { label: '健康文章', path: '/articles/' }], Astro.site)];
---
<Base title="健康文章" description="從生活中的健康問題出發，閱讀營養、成分與日常保健的整理文章。" noindex={all.length === 0} jsonLd={schema}>
  <section class="section"><div class="wrap content-wrap">
    <Breadcrumb items={[{ label: '首頁', href: '/' }, { label: '健康文章' }]} />
    <header class="content-intro"><p class="eyebrow">HEALTH & EVERYDAY LIFE</p><h1>健康文章</h1><p>把關心的問題看清楚，再找到適合自己的日常選擇。</p></header>
    <ArticleList articles={articles} categories={categories} totalPages={totalPages} />
  </div></section>
</Base>
