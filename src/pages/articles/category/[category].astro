---
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/content/Breadcrumb.astro';
import ArticleList from '../../../components/content/ArticleList.astro';
import { getPublishedArticles, articleSlug } from '../../../lib/content';
import { ARTICLE_PAGE_SIZE, listSchema, breadcrumbSchema } from '../../../lib/content-view';
import '../../../styles/content.css';
export async function getStaticPaths() {
  const all = await getPublishedArticles();
  const categories = [...new Set(all.map((article) => article.data.category))];
  return categories.map((category) => {
    const selected = all.filter((article) => article.data.category === category);
    return { params: { category }, props: { category, categories, articles: selected.slice(0, ARTICLE_PAGE_SIZE), totalPages: Math.ceil(selected.length / ARTICLE_PAGE_SIZE) } };
  });
}
const { category, categories, articles, totalPages } = Astro.props;
const path = `/articles/category/${encodeURIComponent(category)}/`;
const schema = [listSchema(category, path, articles.map((article) => ({ title: article.data.title, path: `/articles/${articleSlug(article)}/` })), Astro.site), breadcrumbSchema([{ label: '首頁', path: '/' }, { label: '健康文章', path: '/articles/' }, { label: category, path }], Astro.site)];
---
<Base title={`${category}文章`} description={`閱讀三傑益康整理的${category}文章，從日常問題認識健康與營養。`} jsonLd={schema}>
  <section class="section"><div class="wrap content-wrap">
    <Breadcrumb items={[{ label: '首頁', href: '/' }, { label: '健康文章', href: '/articles/' }, { label: category }]} />
    <header class="content-intro"><h1>{category}</h1></header>
    <ArticleList articles={articles} category={category} categories={categories} totalPages={totalPages} />
  </div></section>
</Base>
