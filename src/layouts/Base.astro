---
import { u } from '../lib/url';
import '../styles/tokens.css';
import '../styles/site.css';
import { Image, getImage } from 'astro:assets';
import { SITE, CONTACT, DISCLAIMER } from '../data/site';
import { IS_PRODUCTION, GA_ID, GSC_TOKEN, SHOP_URL } from '../lib/env';
import { shoppingLink } from '../lib/commerce.mjs';
import { absolute, jsonScript, siteGraph } from '../lib/seo';
import media from '../data/content-images.json';
import { getPublishedArticles } from '../lib/content';
import Icon from '../components/Icon.astro';
import ImageViewer from '../components/content/ImageViewer.astro';
import brandMark from '../assets/published-site/brand-mark.png';

interface Props {
  title?: string;           // 不含站名；首頁留空
  description?: string;
  ogImage?: ImageMetadata | string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
}
const { title, description = SITE.description, ogImage, jsonLd, noindex = false, ogType = 'website', publishedTime, modifiedTime } = Astro.props;
const fullTitle = title ? `${title}｜${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = typeof ogImage === 'string' ? null : ogImage ? await getImage({ src: ogImage, width: 1200, format: 'jpg' }) : null;
const optimizedOg = typeof ogImage === 'string' ? (media as Record<string, {src: string}>)[ogImage]?.src ?? ogImage : undefined;
const ogPath = optimizedOg ? (optimizedOg.startsWith('/') ? u(optimizedOg) : optimizedOg) : og?.src ?? u('/og/default.png');
const ogUrl = absolute(ogPath, Astro.site);
const nodes = [...siteGraph(Astro.site), ...(!jsonLd ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd])];
const isoDate = (value: Date | string | undefined) => value ? new Date(value).toISOString() : undefined;
const path = Astro.url.pathname;
const current = (href: string) => (path.startsWith(u(href)) ? 'page' : undefined);
const shopHref = shoppingLink(SHOP_URL);
const articleCategories = [...new Set((await getPublishedArticles()).map((article) => article.data.category))];
const categoryOrder = ['飲食營養', '保健品判讀', '生活習慣'];
const headerCategories = [...categoryOrder.filter((name) => articleCategories.includes(name)), ...articleCategories.filter((name) => !categoryOrder.includes(name))].slice(0, 3);
---
<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(!IS_PRODUCTION || noindex) && <meta name="robots" content={IS_PRODUCTION ? 'noindex,follow' : 'noindex,nofollow'} />}
    {GSC_TOKEN && <meta name="google-site-verification" content={GSC_TOKEN} />}
    <link rel="icon" type="image/png" href={u('/favicon.png')} />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <link rel="sitemap" href={u('/sitemap-index.xml')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:alt" content={title ?? SITE.name} />
    {publishedTime && <meta property="article:published_time" content={isoDate(publishedTime)} />}
    {modifiedTime && <meta property="article:modified_time" content={isoDate(modifiedTime)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name}最新文章`} href={u('/rss.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@600;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={jsonScript({ '@context': 'https://schema.org', '@graph': nodes })} />
    {IS_PRODUCTION && GA_ID && Astro.url.pathname !== u('/search/') && (
      <>
        <script async is:inline src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline define:vars={{ GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          let cleanReferrer = '';
          try {
            const referrer = new URL(document.referrer);
            if (['http:', 'https:'].includes(referrer.protocol)) cleanReferrer = referrer.origin + referrer.pathname;
          } catch { /* Direct visits have no referrer. */ }
          gtag('config', GA_ID, { page_location: location.origin + location.pathname, page_path: location.pathname, page_referrer: cleanReferrer });
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#main">跳到主要內容</a>
    <header class="site-header" data-pagefind-ignore>
      <div class="masthead-utility"><div class="wrap utility-inner"><a href={u('/about/')}>三傑益康</a><nav aria-label="網站資訊"><a href={u('/authors/')}>編輯團隊</a><a href={u('/editorial-policy/')}>編輯原則</a>{CONTACT.length > 0 && <a href={u('/contact/')}>聯絡我們</a>}</nav></div></div>
      <div class="wrap header-inner">
        <a class="brand" href={u('/')} aria-label={`${SITE.name} 首頁`}>
          <Image src={brandMark} alt="" width={104} height={90} loading="eager" />
          <span class="brand-title">三傑益康<span class="brand-subtitle">健康生活與營養</span></span>
        </a>
        {path !== u('/search/') && <><form class="masthead-search" role="search" action={u('/search/')} method="get"><label for="site-query">搜尋文章</label><div><input id="site-query" type="search" name="q" placeholder="輸入關鍵字" required /><button type="submit"><Icon name="search" />搜尋</button></div></form><a class="mobile-search-link" href={u('/search/')}><Icon name="search" />搜尋</a></>}
      </div>
      <div class="masthead-nav"><div class="wrap">
        <nav class="nav" aria-label="主選單">
          <a href={u('/articles/')} aria-current={path === u('/articles/') || path.startsWith(u('/articles/page/')) ? 'page' : undefined}>最新文章</a>
          {headerCategories.map((name) => <a href={u(`/articles/category/${encodeURIComponent(name)}/`)} aria-current={current(`/articles/category/${encodeURIComponent(name)}/`)}>{name}</a>)}
          <a href={u('/topics/')} aria-current={current('/topics/')}>閱讀專題</a>
          <a href={u('/about/')} aria-current={current('/about/')}>關於三傑</a>
          {shopHref && <a class="nav-shop" href={shopHref} data-ga-shop="" data-shop-placement="header" target="_blank" rel="noopener noreferrer">購物網站 ↗</a>}
        </nav>
      </div></div>
    </header>

    <main id="main">
      <slot />
    </main>
    <ImageViewer />

    <footer class="site-footer" data-pagefind-ignore>
      <div class="wrap footer-inner">
        <div>
          <a class="brand footer-brand" href={u('/')} aria-label={`${SITE.name} 首頁`}><Image src={brandMark} alt="" width={80} height={69} loading="lazy" /><span class="brand-title">三傑益康<span class="brand-subtitle">健康生活與營養</span></span></a>
          <p class="motto">健康生活、飲食營養與保健品判讀</p>
        </div>
        <div class="footer-cols">
          <nav aria-label="頁尾選單">
            <h2 class="footer-nav-title">閱讀內容</h2>
            <a href={u('/')}>首頁</a>
            <a href={u('/articles/')}>健康文章</a>
            <a href={u('/topics/')}>閱讀專題</a>
            <a href={u('/search/')}>搜尋內容</a>
            <a href={u('/authors/')}>內容團隊</a>
            <a href={u('/rss.xml')}>RSS 訂閱</a>
          </nav>
          <nav aria-label="關於本站">
            <h2 class="footer-nav-title">關於本站</h2>
            <a href={u('/about/')}>關於三傑</a>
            {CONTACT.length > 0 && <a href={u('/contact/')}>聯絡我們</a>}
            <a href={u('/editorial-policy/')}>編輯與更正原則</a>
            <a href={u('/disclosure/')}>內容與合作關係</a>
            <a href={u('/privacy/')}>隱私權</a>
            {shopHref && <a href={shopHref} data-ga-shop="" data-shop-placement="footer" target="_blank" rel="noopener noreferrer">前往購物網站</a>}
          </nav>
          {CONTACT.length > 0 && <div class="footer-contact">{CONTACT.map((channel) => <a href={channel.href} data-ga-contact={channel.ga}>{channel.label}</a>)}</div>}
        </div>
      </div>
      <div class="wrap footer-legal">
        <p>{DISCLAIMER}</p>
        <p>© {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>

    <script>
      // GA4 事件：聯絡管道點擊（contact_click）、原廠連結點擊（official_click）。
      // 沒載入 GA（本機、預覽）時什麼都不做。事件名與參數改了會讓報表前後不連續。
      document.addEventListener('click', (e) => {
        const a = (e.target as Element).closest('a');
        const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
        if (!a || !gtag) return;
        if (a.dataset.gaContact) gtag('event', 'contact_click', { channel: a.dataset.gaContact, page_path: location.pathname });
        if (a.dataset.gaOfficial) gtag('event', 'official_click', { product_id: a.dataset.gaOfficial, link_url: a.href });
        if (a.hasAttribute('data-ga-shop')) {
          const article = document.querySelector<HTMLElement>('[data-reading-article]');
          gtag('event', 'shop_click', { product_id: a.dataset.gaShop || undefined, article_slug: article?.dataset.articleSlug, link_domain: new URL(a.href).hostname, placement: a.dataset.shopPlacement || 'content' });
        }
      });
      // 點選行動版選單連結後收起
      document.querySelectorAll<HTMLDetailsElement>('.nav-mobile').forEach((d) =>
        d.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (d.open = false))));
    </script>
  </body>
</html>
